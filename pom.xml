<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.saucedemo</groupId>
    <artifactId>saucedemo-ui-playwright</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>saucedemo-ui-playwright</name>
    <description>E2E UI automation for Swag Labs (saucedemo.com) using Playwright + JUnit 5</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <playwright.version>1.47.0</playwright.version>
        <junit.version>5.11.3</junit.version>
        <surefire.version>3.5.2</surefire.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!--
                      Run sequentially. The shared Playwright/Browser instance and its
                      driver connection are not thread-safe, so tests must not run in
                      parallel against the same browser. Isolation between tests is
                      provided by a fresh BrowserContext per test (see BaseTest).
                    -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <!--
                      NOTE: JaCoCo's prepare-agent injects the coverage agent via
                      the ${argLine} property. Do NOT set a plain <argLine> here or
                      the agent will be dropped and coverage silently reads 0%.
                      If JVM options are ever needed, reference the property, e.g.
                      <argLine>@{argLine} -Dsome.opt=value</argLine>.
                    -->
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <!--
                  SCOPE: This instruments *this framework's own* bytecode
                  (page objects / helpers / test support), NOT the application
                  under test (saucedemo.com is an external web app). The report
                  therefore reflects how much of our own automation code the
                  suite exercises, and must not be read as product coverage.
                -->
                <configuration>
                    <!-- Emit machine-consumable formats for CI ingestion (Sonar/Codecov). -->
                    <formats>
                        <format>XML</format>
                        <format>HTML</format>
                    </formats>
                </configuration>
                <executions>
                    <!--
                      Attach the JaCoCo agent before tests run so coverage is
                      recorded into target/jacoco.exec, then render the report.
                    -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <!--
                          Bound to the `test` phase (not `verify`) so the report is
                          generated by the common `mvn test` invocation used for this
                          E2E suite. Runs after Surefire within the same phase.
                        -->
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
